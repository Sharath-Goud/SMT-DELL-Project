@model SMT_DELL_Project.Models.PMActivity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="delete-page">

    <div class="delete-container">

        <!-- HEADER -->
        <div class="delete-header">

            <div class="delete-logo">
                SMT
            </div>

            <div class="delete-title">

                <h1>
                    @ViewBag.StageName - PM Activities
                </h1>

                <p>
                    Delete Activity
                </p>

            </div>

        </div>


        <!-- DELETE CARD -->
        <div class="delete-card">

            <div class="warning-icon">
                !
            </div>


            <h2>
                Delete Activity
            </h2>


            <p class="delete-message">

                Are you sure you want to delete this activity?

            </p>


            <div class="activity-display">

                <span class="activity-label">
                    Activity
                </span>

                <span class="activity-value">
                    @Model.ActivityName
                </span>

            </div>


            <p class="warning-message">

                This activity will no longer appear in the
                PM checklist for this stage.

            </p>


            <form asp-controller="PMChecklist"
                  asp-action="DeleteActivityConfirmed"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div class="delete-actions">

                    <a asp-controller="PMChecklist"
                       asp-action="Index"
                       asp-route-stageId="@Model.StageId"
                       class="cancel-btn">

                        Cancel

                    </a>


                    <button type="submit"
                            class="delete-btn">

                        <span>
                            🗑
                        </span>

                        Delete Activity

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .delete-page {
        min-height: 100vh;
        padding: 45px 25px;
        background: radial-gradient( circle at 15% 15%, rgba(45, 212, 191, 0.08), transparent 30% ), radial-gradient( circle at 85% 85%, rgba(248, 113, 113, 0.05), transparent 30% ), linear-gradient( 135deg, #0b1117 0%, #101820 45%, #0c131a 100% );
        color: #e5e7eb;
    }


    .delete-container {
        width: 100%;
        max-width: 550px;
        margin: 0 auto;
    }


    .delete-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
    }


    .delete-logo {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient( 145deg, #1f9d8b, #14796e );
        color: #ecfeff;
        font-size: 19px;
        font-weight: 700;
    }


    .delete-title h1 {
        margin: 0;
        color: #f1f5f9;
        font-size: 28px;
        font-weight: 700;
    }


    .delete-title p {
        margin: 5px 0 0;
        color: #8d9aa8;
        font-size: 14px;
    }


    .delete-card {
        padding: 40px 35px;
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(25, 34, 43, 0.97), rgba(15, 23, 31, 0.98) );
        border: 1px solid rgba( 148, 163, 184, 0.12 );
        box-shadow: 0 20px 45px rgba( 0, 0, 0, 0.30 );
        text-align: center;
    }


    .warning-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba( 248, 113, 113, 0.10 );
        border: 1px solid rgba( 248, 113, 113, 0.20 );
        color: #f87171;
        font-size: 28px;
        font-weight: 700;
    }


    .delete-card h2 {
        margin: 0 0 10px;
        color: #f1f5f9;
        font-size: 22px;
    }


    .delete-message {
        margin: 0 0 25px;
        color: #94a3b8;
        font-size: 14px;
    }


    .activity-display {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 18px;
        margin-bottom: 20px;
        border-radius: 10px;
        background: rgba( 7, 13, 19, 0.65 );
        border: 1px solid rgba( 148, 163, 184, 0.12 );
    }


    .activity-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    .activity-value {
        color: #f8fafc;
        font-size: 17px;
        font-weight: 700;
        word-break: break-word;
    }


    .warning-message {
        margin: 0 0 30px;
        color: #fbbf24;
        font-size: 13px;
    }


    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid rgba( 148, 163, 184, 0.08 );
    }


    .cancel-btn {
        min-width: 120px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 18px;
        border-radius: 10px;
        border: 1px solid rgba( 148, 163, 184, 0.18 );
        background: rgba( 148, 163, 184, 0.05 );
        color: #cbd5e1;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }


        .cancel-btn:hover {
            color: #ffffff;
            background: rgba( 148, 163, 184, 0.10 );
        }


    .delete-btn {
        min-width: 155px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 18px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( 145deg, #dc2626, #991b1b );
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }


        .delete-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba( 220, 38, 38, 0.25 );
        }


    @@media (max-width: 600px) {

        .delete-page {
            padding: 30px 18px;
        }

        .delete-card {
            padding: 30px 22px;
        }

        .delete-title h1 {
            font-size: 22px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .cancel-btn,
        .delete-btn {
            width: 100%;
        }
    }

</style>