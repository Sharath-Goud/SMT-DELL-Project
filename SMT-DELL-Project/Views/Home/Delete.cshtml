
@model SMT_DELL_Project.Models.Stage

@{
    ViewData["Title"] = "Delete Stage";
}

<div class="delete-stage-page">

    <div class="delete-stage-container">

        <!-- HEADER -->

        <div class="delete-stage-header">

            <div class="delete-stage-logo">
                SMT
            </div>

            <div>

                <h1>Delete Production Stage</h1>

                <p>
                    Remove the selected production stage
                </p>

            </div>

        </div>


        <!-- DELETE CARD -->

        <div class="delete-stage-card">

            <div class="warning-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M12 9v4"></path>

                    <path d="M12 17h.01"></path>

                    <path d="M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z">
                    </path>

                </svg>

            </div>


            <h2>
                Are you sure you want to delete this stage?
            </h2>


            <div class="stage-name-box">

                <span class="stage-label">
                    Stage Name
                </span>

                <span class="stage-name">
                    @Model.StageName
                </span>

            </div>


            <p class="warning-text">

                This action will permanently remove this
                production stage from the database.

            </p>


            <form asp-controller="Home"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       asp-for="Id" />


                <div class="button-row">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="cancel-btn">

                        Cancel

                    </a>


                    <button type="submit"
                            class="delete-btn">

                        Delete Stage

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .delete-stage-page {
        width: 100%;
        min-height: 100vh;
        padding: 45px 25px;
        background: radial-gradient( circle at 15% 15%, rgba(45, 212, 191, 0.08), transparent 30% ), radial-gradient( circle at 85% 85%, rgba(248, 113, 113, 0.05), transparent 30% ), linear-gradient( 135deg, #0b1117 0%, #101820 45%, #0c131a 100% );
        color: #e5e7eb;
    }


    .delete-stage-container {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }


    .delete-stage-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
    }


    .delete-stage-logo {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient( 145deg, #1f9d8b, #14796e );
        color: #ecfeff;
        font-size: 19px;
        font-weight: 700;
    }


    .delete-stage-header h1 {
        margin: 0;
        color: #f1f5f9;
        font-size: 28px;
        font-weight: 700;
    }


    .delete-stage-header p {
        margin: 5px 0 0;
        color: #8d9aa8;
        font-size: 14px;
    }


    .delete-stage-card {
        padding: 40px 35px;
        text-align: center;
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(25, 34, 43, 0.97), rgba(15, 23, 31, 0.98) );
        border: 1px solid rgba(248, 113, 113, 0.15);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.30);
    }


    .warning-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #f87171;
        background: rgba(248, 113, 113, 0.10);
        border: 1px solid rgba(248, 113, 113, 0.20);
    }


        .warning-icon svg {
            width: 32px;
            height: 32px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    .delete-stage-card h2 {
        margin: 0 0 25px;
        color: #f8fafc;
        font-size: 21px;
        font-weight: 700;
    }


    .stage-name-box {
        padding: 18px 20px;
        margin-bottom: 20px;
        border-radius: 12px;
        background: rgba(7, 13, 19, 0.70);
        border: 1px solid rgba(148, 163, 184, 0.12);
    }


    .stage-label {
        display: block;
        margin-bottom: 6px;
        color: #7f8d9b;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    .stage-name {
        display: block;
        color: #f8fafc;
        font-size: 20px;
        font-weight: 700;
    }


    .warning-text {
        max-width: 500px;
        margin: 0 auto 30px;
        color: #9aa7b4;
        font-size: 13px;
        line-height: 1.6;
    }


    .button-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding-top: 5px;
    }


    .cancel-btn,
    .delete-btn {
        min-width: 140px;
        padding: 12px 20px;
        border-radius: 10px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }


    .cancel-btn {
        color: #cbd5e1;
        background: rgba(71, 85, 105, 0.35);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }


        .cancel-btn:hover {
            color: #ffffff;
            background: rgba(71, 85, 105, 0.55);
            text-decoration: none;
            transform: translateY(-2px);
        }


    .delete-btn {
        color: #fff1f2;
        background: linear-gradient( 145deg, #dc4b4b, #b93636 );
        border: 1px solid rgba(248, 113, 113, 0.25);
        box-shadow: 0 8px 20px rgba(185, 54, 54, 0.20);
    }


        .delete-btn:hover {
            transform: translateY(-2px);
            background: linear-gradient( 145deg, #e25555, #c13b3b );
            box-shadow: 0 12px 25px rgba(185, 54, 54, 0.30);
        }


    @@media (max-width: 600px) {
        .delete-stage-page

    {
        padding: 30px 18px;
    }


    .delete-stage-card {
        padding: 30px 22px;
    }


    .delete-stage-header h1 {
        font-size: 23px;
    }


    .button-row {
        flex-direction: column-reverse;
    }


    .cancel-btn,
    .delete-btn {
        width: 100%;
    }

    }
</style>

