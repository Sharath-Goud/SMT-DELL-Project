<script>

    function openStage(id, stageName) {

        window.location.href =
            '@Url.Action("Index", "PMChecklist")' +
            '?stageId=' +
            id +
            '&stageName=' +
            encodeURIComponent(stageName);

    }


    @if (User.IsInRole("Admin"))
    {
            <text>

            let reminderAlreadyChecked = false;


            async function checkPMReminder() {

                if (reminderAlreadyChecked) {
                    return;
                }

                try {

                    const response = await fetch(
                        '@Url.Action("CheckReminder", "Home")',
                        {
                            method: 'GET',
                            cache: 'no-store'
                        }
                    );


                    if (!response.ok) {

                        console.error(
                            "Reminder request failed:",
                            response.status
                        );

                        return;
                    }


                    const data = await response.json();


                    if (data.showPopup === true) {

                        reminderAlreadyChecked = true;


                        // First display the popup
                        showReminderPopup(data.message);


                        // Then mark popup as displayed
                        acknowledgeReminderPopup(data.reminderId);

                    }

                }
                catch (error) {

                    console.error(
                        "Unable to check PM reminder:",
                        error
                    );

                }

            }


            function showReminderPopup(message) {

                const alertBox =
                    document.getElementById(
                        "dashboardReminderPopup"
                    );


                const messageElement =
                    document.getElementById(
                        "dashboardReminderMessage"
                    );


                if (!alertBox || !messageElement) {

                    console.error(
                        "PM reminder popup HTML elements not found."
                    );

                    return;

                }


                messageElement.textContent =
                    message;


                alertBox.classList.add("show");


                setTimeout(function () {

                    closeReminderPopup();

                }, 10000);

            }


            async function acknowledgeReminderPopup(reminderId) {

                try {

                    const tokenElement =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        );


                    if (!tokenElement) {

                        console.error(
                            "Anti-forgery token not found."
                        );

                        return;

                    }


                    const formData =
                        new URLSearchParams();


                    formData.append(
                        "__RequestVerificationToken",
                        tokenElement.value
                    );


                    formData.append(
                        "reminderId",
                        reminderId
                    );


                    const response =
                        await fetch(
                            '@Url.Action("AcknowledgeReminderPopup", "Home")',
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type':
                                        'application/x-www-form-urlencoded; charset=UTF-8'
                                },
                                body: formData.toString()
                            }
                        );


                    if (!response.ok) {

                        console.error(
                            "Unable to acknowledge PM reminder popup."
                        );

                    }

                }
                catch (error) {

                    console.error(
                        "Error acknowledging PM reminder popup:",
                        error
                    );

                }

            }


            function closeReminderPopup() {

                const alertBox =
                    document.getElementById(
                        "dashboardReminderPopup"
                    );


                if (alertBox) {

                    alertBox.classList.remove("show");

                }

            }


            // Check immediately
            checkPMReminder();


            // Check every 30 seconds
            setInterval(
                checkPMReminder,
                30000
            );

            </text>
    }

</script>