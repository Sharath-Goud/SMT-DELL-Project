@model SMT_DELL_Project.Models.RegisterViewModel

@{
    ViewData["Title"] = "Employee Registration";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Employee Registration</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

</head>

<body>

    <div class="auth-page">

        <div class="auth-card">

            <!-- BRAND -->

            <div class="brand">

                <div class="brand-logo">
                    S
                </div>

                <div class="brand-text">

                    <h1>Employee Portal</h1>

                    <p>SMT DELL Project</p>

                </div>

            </div>


            <!-- HEADER -->

            <div class="auth-header">

                <h2>Create Account</h2>

                <p>
                    Register using your employee details.
                </p>

            </div>


            <!-- FORM -->

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <!-- General validation -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- Employee ID -->

                <div class="form-group">

                    <label asp-for="EmployeeId">
                    </label>

                    <input asp-for="EmployeeId"
                           class="form-control"
                           placeholder="Enter Employee ID"
                           autocomplete="username" />

                    <span asp-validation-for="EmployeeId"
                          class="validation-message">
                    </span>

                </div>


                <!-- Name -->

                <div class="form-group">

                    <label asp-for="Name">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter your name"
                           autocomplete="name" />

                    <span asp-validation-for="Name"
                          class="validation-message">
                    </span>

                </div>


                <!-- Password -->

                <div class="form-group">

                    <label asp-for="Password">
                    </label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="validation-message">
                    </span>

                </div>


                <!-- Confirm Password -->

                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-message">
                    </span>

                </div>


                <!-- Register button -->

                <button type="submit"
                        class="btn-primary">

                    Create Account

                </button>

            </form>


            <!-- Login link -->

            <div class="bottom-link">

                <span>
                    Already have an account?
                </span>

                <a asp-controller="Account"
                   asp-action="Login">

                    Login

                </a>

            </div>

        </div>

    </div>


    <!-- Client-side validation -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>